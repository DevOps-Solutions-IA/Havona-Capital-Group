NODE_ENV=development
POSTGRES_DB=havona
POSTGRES_USER=havona
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT_EXPOSED=5432
DATABASE_URL=postgresql://havona:replace-with-a-long-random-password@localhost:5432/havona?schema=public
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT_EXPOSED=6379
REDIS_URL=redis://:replace-with-a-long-random-password@localhost:6379
SESSION_COOKIE_NAME=havona_session
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INITIAL_SUPER_ADMIN_NAME=Super Administrador
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=replace-With-at-least-16-characters!
RATE_LIMIT_PER_MINUTE=100
WORKER_CONCURRENCY=5
WORKER_QUEUE_NAME=havona-system
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=HAVONA CAPITAL <no-reply@example.com>
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
BACKUP_RETENTION_DAYS=14
BACKUP_PATH=./backups
