NODE_ENV=development
POSTGRES_DB=havona
POSTGRES_USER=havona
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://havona:replace-with-a-long-random-password@postgres:5432/havona?schema=public
REDIS_URL=redis://redis:6379
SESSION_COOKIE_NAME=havona_session
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-at-least-16-characters
CADDY_DOMAIN=localhost
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase

