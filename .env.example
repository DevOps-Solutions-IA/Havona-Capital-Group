POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT_EXPOSED=5432
DATABASE_URL=postgresql://havona:replace-with-a-long-random-password@localhost:5432/havona?schema=public
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT_EXPOSED=6379
REDIS_URL=redis://:replace-with-a-long-random-password@localhost:6379
SESSION_COOKIE_NAME=havona_session
COOKIE_DOMAIN=
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INITIAL_SUPER_ADMIN_NAME=Super Administrador
