{
  "name": "@havona/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:integration": "pnpm --filter '@havona/api^...' build && jest --config jest.integration.json --runInBand",
    "knowledge:palig-dry-run": "node -r ts-node/register scripts/palig-ingestion-dry-run.ts",
    "knowledge:markdown-dry-run": "node -r ts-node/register scripts/markdown-canonical-dry-run.ts"
  },
  "dependencies": {
    "@havona/auth": "workspace:*",
    "@havona/contracts": "workspace:*",
    "@havona/database": "workspace:*",
    "@havona/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/throttler": "^6.4.0",
    "bullmq": "^5.41.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "1.1.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
