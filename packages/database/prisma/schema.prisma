generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                    @id @default(uuid()) @db.Uuid
  email               String                    @unique @db.VarChar(254)
  name                String                    @db.VarChar(120)
  passwordHash        String                    @map("password_hash")
  isActive            Boolean                   @default(true) @map("is_active")
  failedLoginAttempts Int                       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?                 @map("locked_until")
  lastLoginAt         DateTime?                 @map("last_login_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]                @relation("AuditActor")
  assignedProspects   Assignment[]              @relation("AssignmentAssignee")
  prospectAssignments Assignment[]              @relation("AssignmentActor")
  opportunities       Opportunity[]             @relation("OpportunityOwner")
  stageChanges        OpportunityStageHistory[] @relation("StageChangedBy")
  crmTasks            Task[]                    @relation("TaskAssignee")
  createdTasks        Task[]                    @relation("TaskCreator")
  notes               Note[]                    @relation("NoteAuthor")
  activities          Activity[]                @relation("ActivityActor")
  interactions        Interaction[]             @relation("InteractionActor")
  convertedClients    ClientProfile[]           @relation("ClientConvertedBy")

  @@map("users")
}

enum ProspectStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum ConsentType {
  DATA_PROCESSING
}

enum LeadEventType {
  CAPTURED
  RECAPTURED
}

model LeadSource {
  id        String      @id @default(uuid()) @db.Uuid
  key       String      @unique @db.VarChar(40)
  name      String      @db.VarChar(80)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  prospects Prospect[]
  events    LeadEvent[]

  @@map("lead_sources")
}

model Prospect {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(120)
  phone           String?          @db.VarChar(30)
  normalizedPhone String?          @unique @map("normalized_phone") @db.VarChar(20)
  email           String?          @db.VarChar(254)
  normalizedEmail String?          @unique @map("normalized_email") @db.VarChar(254)
  city            String           @db.VarChar(100)
  sourceId        String           @map("source_id") @db.Uuid
  campaign        String?          @db.VarChar(100)
  landing         String           @db.VarChar(80)
  interest        String           @db.VarChar(60)
  message         String?          @db.VarChar(1200)
  status          ProspectStatus   @default(NEW)
  firstCapturedAt DateTime         @default(now()) @map("first_captured_at")
  lastCapturedAt  DateTime         @default(now()) @map("last_captured_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  source          LeadSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  consents        Consent[]
  events          LeadEvent[]
  assignments     Assignment[]
  opportunities   Opportunity[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]
  tags            ProspectTag[]
  interactions    Interaction[]
  client          ClientProfile?
  companyContacts CompanyContact[]

  @@index([status, createdAt])
  @@index([sourceId, createdAt])
  @@index([landing, createdAt])
  @@map("prospects")
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  PROSPECT_CAPTURED
  ASSIGNED
  REASSIGNED
  INTERACTION_RECORDED
  NOTE_CREATED
  NOTE_UPDATED
  TASK_CREATED
  TASK_STATUS_CHANGED
  STAGE_CHANGED
  OPPORTUNITY_CREATED
  OPPORTUNITY_CLOSED
  PROSPECT_UPDATED
  TAG_ATTACHED
  TAG_DETACHED
  CLIENT_CONVERTED
  COMPANY_CREATED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model ClientProfile {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @unique @map("prospect_id") @db.Uuid
  convertedById String       @map("converted_by_id") @db.Uuid
  status        ClientStatus @default(ACTIVE)
  convertedAt   DateTime     @default(now()) @map("converted_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  convertedBy   User         @relation("ClientConvertedBy", fields: [convertedById], references: [id], onDelete: Restrict)

  @@index([status, convertedAt])
  @@map("crm_clients")
}

model Company {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @db.VarChar(160)
  legalName     String?          @map("legal_name") @db.VarChar(200)
  taxIdentifier String?          @unique @map("tax_identifier") @db.VarChar(40)
  city          String?          @db.VarChar(100)
  email         String?          @db.VarChar(254)
  phone         String?          @db.VarChar(30)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  contacts      CompanyContact[]

  @@index([name])
  @@map("crm_companies")
}

model CompanyContact {
  companyId  String   @map("company_id") @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  position   String?  @db.VarChar(120)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  @@id([companyId, prospectId])
  @@index([prospectId])
  @@map("crm_company_contacts")
}

enum ContactMethod {
  PHONE
  EMAIL
  MEETING
  VIDEO
  OTHER
}

model PipelineStage {
  id              String                    @id @default(uuid()) @db.Uuid
  key             String                    @unique @db.VarChar(40)
  name            String                    @db.VarChar(80)
  position        Int                       @unique
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  opportunities   Opportunity[]
  transitionsFrom OpportunityStageHistory[] @relation("PreviousStage")
  transitionsTo   OpportunityStageHistory[] @relation("NewStage")

  @@map("pipeline_stages")
}

model Opportunity {
  id           String                    @id @default(uuid()) @db.Uuid
  prospectId   String                    @map("prospect_id") @db.Uuid
  stageId      String                    @map("stage_id") @db.Uuid
  ownerId      String?                   @map("owner_id") @db.Uuid
  title        String                    @db.VarChar(160)
  priority     OpportunityPriority       @default(MEDIUM)
  status       OpportunityStatus         @default(OPEN)
  closedAt     DateTime?                 @map("closed_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  prospect     Prospect                  @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  stage        PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner        User?                     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageHistory OpportunityStageHistory[]
  tasks        Task[]
  notes        Note[]
  activities   Activity[]
  interactions Interaction[]

  @@index([stageId, status, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@index([prospectId, createdAt])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id              String         @id @default(uuid()) @db.Uuid
  opportunityId   String         @map("opportunity_id") @db.Uuid
  previousStageId String?        @map("previous_stage_id") @db.Uuid
  newStageId      String         @map("new_stage_id") @db.Uuid
  changedById     String         @map("changed_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  previousStage   PipelineStage? @relation("PreviousStage", fields: [previousStageId], references: [id], onDelete: Restrict)
  newStage        PipelineStage  @relation("NewStage", fields: [newStageId], references: [id], onDelete: Restrict)
  changedBy       User           @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@map("opportunity_stage_history")
}

model Assignment {
  id           String    @id @default(uuid()) @db.Uuid
  prospectId   String    @map("prospect_id") @db.Uuid
  assigneeId   String    @map("assignee_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assignee     User      @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy   User      @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([prospectId, endedAt])
  @@index([assigneeId, endedAt])
  @@map("assignments")
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  assigneeId    String       @map("assignee_id") @db.Uuid
  createdById   String       @map("created_by_id") @db.Uuid
  title         String       @db.VarChar(160)
  description   String?      @db.VarChar(1200)
  dueAt         DateTime     @map("due_at")
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy     User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assigneeId, status, dueAt])
  @@index([prospectId, createdAt])
  @@map("crm_tasks")
}

model Note {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  authorId      String       @map("author_id") @db.Uuid
  body          String       @db.VarChar(4000)
  editedAt      DateTime?    @map("edited_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author        User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@map("crm_notes")
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  actorId       String?      @map("actor_id") @db.Uuid
  type          ActivityType
  summary       String       @db.VarChar(300)
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([opportunityId, createdAt])
  @@map("crm_activities")
}

model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(60)
  color     String        @db.VarChar(7)
  createdAt DateTime      @default(now()) @map("created_at")
  prospects ProspectTag[]

  @@map("crm_tags")
}

model ProspectTag {
  prospectId String   @map("prospect_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
  @@map("prospect_tags")
}

model Interaction {
  id            String        @id @default(uuid()) @db.Uuid
  prospectId    String        @map("prospect_id") @db.Uuid
  opportunityId String?       @map("opportunity_id") @db.Uuid
  actorId       String        @map("actor_id") @db.Uuid
  method        ContactMethod
  summary       String        @db.VarChar(1200)
  occurredAt    DateTime      @map("occurred_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  prospect      Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         User          @relation("InteractionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([prospectId, occurredAt])
  @@map("crm_interactions")
}

model Consent {
  id             String      @id @default(uuid()) @db.Uuid
  prospectId     String      @map("prospect_id") @db.Uuid
  type           ConsentType @default(DATA_PROCESSING)
  accepted       Boolean
  privacyVersion String      @map("privacy_version") @db.VarChar(40)
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.VarChar(512)
  acceptedAt     DateTime    @default(now()) @map("accepted_at")
  prospect       Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, acceptedAt])
  @@map("consents")
}

model LeadEvent {
  id           String        @id @default(uuid()) @db.Uuid
  prospectId   String        @map("prospect_id") @db.Uuid
  submissionId String        @unique @map("submission_id") @db.Uuid
  type         LeadEventType
  sourceId     String        @map("source_id") @db.Uuid
  landing      String        @db.VarChar(80)
  campaign     String?       @db.VarChar(100)
  interest     String        @db.VarChar(60)
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  prospect     Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  source       LeadSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@index([type, createdAt])
  @@index([sourceId, createdAt])
  @@map("lead_events")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(40)
  description String?          @db.VarChar(240)
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  description String           @db.VarChar(240)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfHash  String    @map("csrf_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  resource    String   @db.VarChar(80)
  resourceId  String?  @map("resource_id") @db.VarChar(80)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(240)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
