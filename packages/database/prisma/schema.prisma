  parentTemplate   EmailTemplate        @relation("EmailVariantParent", fields: [parentTemplateId], references: [id], onDelete: Cascade)
  parentVersion    EmailTemplateVersion @relation(fields: [parentVersionId], references: [id], onDelete: Restrict)
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  drafts           EmailTemplateDraft[]
  usages           EmailTemplateUsage[]

  @@index([ownerId, updatedAt])
  @@index([parentTemplateId, parentVersionId])
  @@map("email_template_variants")
}

model EmailTemplateDraft {
  id                       String                    @id @default(uuid()) @db.Uuid
  ownerId                  String                    @map("owner_id") @db.Uuid
  createdById              String                    @map("created_by_id") @db.Uuid
  templateId               String?                   @map("template_id") @db.Uuid
  templateVersionId        String?                   @map("template_version_id") @db.Uuid
  variantId                String?                   @map("variant_id") @db.Uuid
  status                   EmailDraftStatus          @default(DRAFT)
  recipientProspectId      String?                   @map("recipient_prospect_id") @db.Uuid
  companyId                String?                   @map("company_id") @db.Uuid
  opportunityId            String?                   @map("opportunity_id") @db.Uuid
  communicationThreadId    String?                   @map("communication_thread_id") @db.Uuid
  calendarEventId          String?                   @map("calendar_event_id") @db.Uuid
  meetingId                String?                   @map("meeting_id") @db.Uuid
  subjectOverride          String?                   @map("subject_override") @db.VarChar(300)
  editableBlockOverrides   Json?                     @map("editable_block_overrides")
  attachmentReferences     Json?                     @map("attachment_references")
  generatedByHenry         Boolean                   @default(false) @map("generated_by_henry")
  renderedSnapshot         Json?                     @map("rendered_snapshot")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  owner                    User                      @relation("EmailDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy                User                      @relation("EmailDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  template                 EmailTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion          EmailTemplateVersion?     @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  variant                  EmailTemplateVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  recipientProspect        Prospect?                 @relation(fields: [recipientProspectId], references: [id], onDelete: SetNull)
  company                  Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity              Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  communicationThread      CommunicationThread?      @relation(fields: [communicationThreadId], references: [id], onDelete: SetNull)
  calendarEvent            CalendarEventLink?        @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  meeting                  Meeting?                  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  usages                   EmailTemplateUsage[]
  henryMessagingOperations HenryMessagingOperation[]

  @@index([ownerId, status, updatedAt])
  @@index([recipientProspectId, updatedAt])
  @@index([communicationThreadId])
  @@map("email_template_drafts")
}

model EmailSignature {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  displayName   String   @map("display_name") @db.VarChar(120)
  title         String?  @db.VarChar(120)
  phone         String?  @db.VarChar(30)
  email         String   @db.VarChar(254)
  approvedLinks Json?    @map("approved_links")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, isDefault])
  @@map("email_signatures")
}

model EmailTemplateUsage {
  id                     String                @id @default(uuid()) @db.Uuid
  templateId             String                @map("template_id") @db.Uuid
  templateVersionId      String                @map("template_version_id") @db.Uuid
  variantId              String?               @map("variant_id") @db.Uuid
  draftId                String?               @map("draft_id") @db.Uuid
  actorId                String                @map("actor_id") @db.Uuid
  communicationMessageId String?               @map("communication_message_id") @db.Uuid
  snapshot               Json
  createdAt              DateTime              @default(now()) @map("created_at")
  template               EmailTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion        EmailTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  variant                EmailTemplateVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  draft                  EmailTemplateDraft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  actor                  User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  communicationMessage   CommunicationMessage? @relation(fields: [communicationMessageId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([draftId])
  @@map("email_template_usages")
}
