generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  name String @db.VarChar(120)
  passwordHash String @map("password_hash")
  isActive Boolean @default(true) @map("is_active")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil DateTime? @map("locked_until")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roles UserRole[]
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs AuditLog[] @relation("AuditActor")
  @@map("users")
}

enum ProspectStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum ConsentType {
  DATA_PROCESSING
}

enum LeadEventType {
  CAPTURED
  RECAPTURED
}

model LeadSource {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(40)
  name String @db.VarChar(80)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  prospects Prospect[]
  events LeadEvent[]
  @@map("lead_sources")
}

model Prospect {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  phone String? @db.VarChar(30)
  normalizedPhone String? @unique @map("normalized_phone") @db.VarChar(20)
  email String? @db.VarChar(254)
  normalizedEmail String? @unique @map("normalized_email") @db.VarChar(254)
  city String @db.VarChar(100)
  sourceId String @db.Uuid @map("source_id")
  campaign String? @db.VarChar(100)
  landing String @db.VarChar(80)
  interest String @db.VarChar(60)
  message String? @db.VarChar(1200)
  status ProspectStatus @default(NEW)
  firstCapturedAt DateTime @default(now()) @map("first_captured_at")
  lastCapturedAt DateTime @default(now()) @map("last_captured_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  source LeadSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  consents Consent[]
  events LeadEvent[]
  @@index([status, createdAt])
  @@index([sourceId, createdAt])
  @@index([landing, createdAt])
  @@map("prospects")
}

model Consent {
  id String @id @default(uuid()) @db.Uuid
  prospectId String @db.Uuid @map("prospect_id")
  type ConsentType @default(DATA_PROCESSING)
  accepted Boolean
  privacyVersion String @map("privacy_version") @db.VarChar(40)
  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(512)
  acceptedAt DateTime @default(now()) @map("accepted_at")
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  @@index([prospectId, acceptedAt])
  @@map("consents")
}

model LeadEvent {
  id String @id @default(uuid()) @db.Uuid
  prospectId String @db.Uuid @map("prospect_id")
  submissionId String @unique @db.Uuid @map("submission_id")
  type LeadEventType
  sourceId String @db.Uuid @map("source_id")
  landing String @db.VarChar(80)
  campaign String? @db.VarChar(100)
  interest String @db.VarChar(60)
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  source LeadSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  @@index([prospectId, createdAt])
  @@index([type, createdAt])
  @@index([sourceId, createdAt])
  @@map("lead_events")
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(40)
  description String? @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at")
  users UserRole[]
  permissions RolePermission[]
  @@map("roles")
}
model Permission {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(80)
  description String @db.VarChar(240)
  roles RolePermission[]
  @@map("permissions")
}
model UserRole {
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@map("user_roles")
}
model RolePermission {
  roleId String @db.Uuid @map("role_id")
  permissionId String @db.Uuid @map("permission_id")
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  csrfHash String @map("csrf_hash") @db.Char(64)
  userId String @db.Uuid @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  userId String @db.Uuid @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}
model AuditLog {
  id BigInt @id @default(autoincrement())
  actorUserId String? @db.Uuid @map("actor_user_id")
  action String @db.VarChar(80)
  resource String @db.VarChar(80)
  resourceId String? @map("resource_id") @db.VarChar(80)
  metadata Json?
  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
model SystemSetting {
  key String @id @db.VarChar(100)
  value Json
  description String? @db.VarChar(240)
  isPublic Boolean @default(false) @map("is_public")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("system_settings")
}
