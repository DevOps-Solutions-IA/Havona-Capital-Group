generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                    @id @default(uuid()) @db.Uuid
  email                          String                    @unique @db.VarChar(254)
  name                           String                    @db.VarChar(120)
  passwordHash                   String                    @map("password_hash")
  isActive                       Boolean                   @default(true) @map("is_active")
  failedLoginAttempts            Int                       @default(0) @map("failed_login_attempts")
  lockedUntil                    DateTime?                 @map("locked_until")
  lastLoginAt                    DateTime?                 @map("last_login_at")
  createdAt                      DateTime                  @default(now()) @map("created_at")
  updatedAt                      DateTime                  @updatedAt @map("updated_at")
  roles                          UserRole[]
  sessions                       Session[]
  passwordResetTokens            PasswordResetToken[]
  auditLogs                      AuditLog[]                @relation("AuditActor")
  assignedProspects              Assignment[]              @relation("AssignmentAssignee")
  prospectAssignments            Assignment[]              @relation("AssignmentActor")
  opportunities                  Opportunity[]             @relation("OpportunityOwner")
  stageChanges                   OpportunityStageHistory[] @relation("StageChangedBy")
  crmTasks                       Task[]                    @relation("TaskAssignee")
  createdTasks                   Task[]                    @relation("TaskCreator")
  notes                          Note[]                    @relation("NoteAuthor")
  activities                     Activity[]                @relation("ActivityActor")
  interactions                   Interaction[]             @relation("InteractionActor")
  convertedClients               ClientProfile[]           @relation("ClientConvertedBy")
  conversationParticipants       ConversationParticipant[]
  assignedEscalations            Escalation[]              @relation("EscalationAssignee")
  voiceSessions                  VoiceSession[]
  calendarConnections            CalendarConnection[]
  calendarAvailability           CalendarAvailabilityRule?
  calendarEventsCreated          CalendarEventLink[]       @relation("CalendarEventCreator")
  calendarEventsAssigned         CalendarEventLink[]       @relation("CalendarEventAssignee")
  calendarTeamMembers            CalendarTeamMembership[]  @relation("CalendarTeamManager")
  calendarTeamManagers           CalendarTeamMembership[]  @relation("CalendarTeamMember")
  calendarTeamAssignmentsCreated CalendarTeamMembership[]  @relation("CalendarTeamCreatedBy")
  meetingsCreated                Meeting[]                 @relation("MeetingCreator")
  meetingsOwned                  Meeting[]                 @relation("MeetingOwner")
  meetingsAssigned               Meeting[]                 @relation("MeetingAssignee")
  meetingParticipants            MeetingParticipant[]
  meetingInvitationsCreated      MeetingInvitation[]       @relation("MeetingInvitationCreator")
  communicationThreadsAssigned   CommunicationThread[]     @relation("CommunicationThreadAssignee")
  communicationMessagesCreated   CommunicationMessage[]    @relation("CommunicationMessageCreator")
  communicationAssignments       CommunicationAssignment[] @relation("CommunicationAssignmentAssignee")
  communicationAssignmentsMade   CommunicationAssignment[] @relation("CommunicationAssignmentActor")
  analyticsGoalsCreated          AnalyticsGoal[]           @relation("AnalyticsGoalCreator")
  analyticsGoalsScoped           AnalyticsGoal[]           @relation("AnalyticsGoalScopeUser")
  knowledgeDocumentsOwned        KnowledgeDocument[]       @relation("KnowledgeDocumentOwner")
  knowledgeVersionsCreated       KnowledgeVersion[]        @relation("KnowledgeVersionCreator")
  knowledgeVersionsApproved      KnowledgeVersion[]        @relation("KnowledgeVersionApprover")
  trainingProgramsCreated        TrainingProgram[]         @relation("TrainingProgramCreator")
  trainingEnrollments            TrainingEnrollment[]
  trainingAttempts               TrainingAttempt[]
  trainingRoleplays              TrainingRoleplay[]
  henryMemories                  HenryMemory[]
  emailTemplatesOwned            EmailTemplate[]           @relation("EmailTemplateOwner")
  emailTemplatesCreated          EmailTemplate[]           @relation("EmailTemplateCreator")
  emailTemplatesUpdated          EmailTemplate[]           @relation("EmailTemplateUpdater")
  emailTemplateVersionsCreated   EmailTemplateVersion[]    @relation("EmailTemplateVersionCreator")
  emailTemplateVersionsApproved  EmailTemplateVersion[]    @relation("EmailTemplateVersionApprover")
  emailTemplateVariants          EmailTemplateVariant[]
  emailDrafts                    EmailTemplateDraft[]      @relation("EmailDraftOwner")
  emailDraftsCreated             EmailTemplateDraft[]      @relation("EmailDraftCreator")
  emailSignatures                EmailSignature[]
  emailTemplateUsages            EmailTemplateUsage[]
  henryMessagingOperations       HenryMessagingOperation[]
  cadencesCreated                CommunicationCadence[]    @relation("CadenceCreator")
  cadenceEnrollments             CadenceEnrollment[]       @relation("CadenceEnrollmentActor")

  @@map("users")
}

enum ProspectStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum ConsentType {
  DATA_PROCESSING
}

enum LeadEventType {
  CAPTURED
  RECAPTURED
}

model LeadSource {
  id        String      @id @default(uuid()) @db.Uuid
  key       String      @unique @db.VarChar(40)
  name      String      @db.VarChar(80)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  prospects Prospect[]
  events    LeadEvent[]

  @@map("lead_sources")
}

model Prospect {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @db.VarChar(120)
  phone                    String?                   @db.VarChar(30)
  normalizedPhone          String?                   @unique @map("normalized_phone") @db.VarChar(20)
  email                    String?                   @db.VarChar(254)
  normalizedEmail          String?                   @unique @map("normalized_email") @db.VarChar(254)
  city                     String                    @db.VarChar(100)
  sourceId                 String                    @map("source_id") @db.Uuid
  campaign                 String?                   @db.VarChar(100)
  landing                  String                    @db.VarChar(80)
  interest                 String                    @db.VarChar(60)
  message                  String?                   @db.VarChar(1200)
  status                   ProspectStatus            @default(NEW)
  firstCapturedAt          DateTime                  @default(now()) @map("first_captured_at")
  lastCapturedAt           DateTime                  @default(now()) @map("last_captured_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  source                   LeadSource                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  consents                 Consent[]
  events                   LeadEvent[]
  assignments              Assignment[]
  opportunities            Opportunity[]
  tasks                    Task[]
  notes                    Note[]
  emailDrafts              EmailTemplateDraft[]
  activities               Activity[]
  tags                     ProspectTag[]
  interactions             Interaction[]
  client                   ClientProfile?
  companyContacts          CompanyContact[]
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  calendarEvents           CalendarEventLink[]
  meetings                 Meeting[]
  communicationThreads     CommunicationThread[]
  cadenceEnrollments       CadenceEnrollment[]

  @@index([status, createdAt])
  @@index([sourceId, createdAt])
  @@index([landing, createdAt])
  @@map("prospects")
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  PROSPECT_CAPTURED
  ASSIGNED
  REASSIGNED
  INTERACTION_RECORDED
  NOTE_CREATED
  NOTE_UPDATED
  TASK_CREATED
  TASK_STATUS_CHANGED
  STAGE_CHANGED
  OPPORTUNITY_CREATED
  OPPORTUNITY_CLOSED
  PROSPECT_UPDATED
  TAG_ATTACHED
  TAG_DETACHED
  CLIENT_CONVERTED
  COMPANY_CREATED
  HENRY_CONVERSATION_STARTED
  HENRY_INTERACTION_RECORDED
  HENRY_ESCALATION_REQUESTED
  HENRY_APPOINTMENT_INTENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model ClientProfile {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @unique @map("prospect_id") @db.Uuid
  convertedById String       @map("converted_by_id") @db.Uuid
  status        ClientStatus @default(ACTIVE)
  convertedAt   DateTime     @default(now()) @map("converted_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  convertedBy   User         @relation("ClientConvertedBy", fields: [convertedById], references: [id], onDelete: Restrict)

  @@index([status, convertedAt])
  @@map("crm_clients")
}

model Company {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(160)
  legalName            String?               @map("legal_name") @db.VarChar(200)
  taxIdentifier        String?               @unique @map("tax_identifier") @db.VarChar(40)
  city                 String?               @db.VarChar(100)
  email                String?               @db.VarChar(254)
  phone                String?               @db.VarChar(30)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  contacts             CompanyContact[]
  calendarEvents       CalendarEventLink[]
  meetings             Meeting[]
  communicationThreads CommunicationThread[]
  emailDrafts          EmailTemplateDraft[]
  cadenceEnrollments   CadenceEnrollment[]

  @@index([name])
  @@map("crm_companies")
}

model CompanyContact {
  companyId  String   @map("company_id") @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  position   String?  @db.VarChar(120)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  @@id([companyId, prospectId])
  @@index([prospectId])
  @@map("crm_company_contacts")
}

enum ContactMethod {
  PHONE
  EMAIL
  MEETING
  VIDEO
  OTHER
}

model PipelineStage {
  id              String                    @id @default(uuid()) @db.Uuid
  key             String                    @unique @db.VarChar(40)
  name            String                    @db.VarChar(80)
  position        Int                       @unique
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  opportunities   Opportunity[]
  transitionsFrom OpportunityStageHistory[] @relation("PreviousStage")
  transitionsTo   OpportunityStageHistory[] @relation("NewStage")

  @@map("pipeline_stages")
}

model Opportunity {
  id                   String                    @id @default(uuid()) @db.Uuid
  prospectId           String                    @map("prospect_id") @db.Uuid
  stageId              String                    @map("stage_id") @db.Uuid
  ownerId              String?                   @map("owner_id") @db.Uuid
  title                String                    @db.VarChar(160)
  priority             OpportunityPriority       @default(MEDIUM)
  status               OpportunityStatus         @default(OPEN)
  closedAt             DateTime?                 @map("closed_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  prospect             Prospect                  @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  stage                PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner                User?                     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageHistory         OpportunityStageHistory[]
  tasks                Task[]
  notes                Note[]
  activities           Activity[]
  interactions         Interaction[]
  calendarEvents       CalendarEventLink[]
  meetings             Meeting[]
  communicationThreads CommunicationThread[]
  emailDrafts          EmailTemplateDraft[]
  cadenceEnrollments   CadenceEnrollment[]

  @@index([stageId, status, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@index([prospectId, createdAt])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id              String         @id @default(uuid()) @db.Uuid
  opportunityId   String         @map("opportunity_id") @db.Uuid
  previousStageId String?        @map("previous_stage_id") @db.Uuid
  newStageId      String         @map("new_stage_id") @db.Uuid
  changedById     String         @map("changed_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  previousStage   PipelineStage? @relation("PreviousStage", fields: [previousStageId], references: [id], onDelete: Restrict)
  newStage        PipelineStage  @relation("NewStage", fields: [newStageId], references: [id], onDelete: Restrict)
  changedBy       User           @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@map("opportunity_stage_history")
}

model Assignment {
  id           String    @id @default(uuid()) @db.Uuid
  prospectId   String    @map("prospect_id") @db.Uuid
  assigneeId   String    @map("assignee_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assignee     User      @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy   User      @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([prospectId, endedAt])
  @@index([assigneeId, endedAt])
  @@map("assignments")
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  assigneeId    String       @map("assignee_id") @db.Uuid
  createdById   String       @map("created_by_id") @db.Uuid
  title         String       @db.VarChar(160)
  description   String?      @db.VarChar(1200)
  dueAt         DateTime     @map("due_at")
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy     User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  escalations   Escalation[]

  @@index([assigneeId, status, dueAt])
  @@index([prospectId, createdAt])
  @@map("crm_tasks")
}

model Note {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  authorId      String       @map("author_id") @db.Uuid
  body          String       @db.VarChar(4000)
  editedAt      DateTime?    @map("edited_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author        User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@map("crm_notes")
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  actorId       String?      @map("actor_id") @db.Uuid
  type          ActivityType
  summary       String       @db.VarChar(300)
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([opportunityId, createdAt])
  @@map("crm_activities")
}

model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(60)
  color     String        @db.VarChar(7)
  createdAt DateTime      @default(now()) @map("created_at")
  prospects ProspectTag[]

  @@map("crm_tags")
}

model ProspectTag {
  prospectId String   @map("prospect_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
  @@map("prospect_tags")
}

model Interaction {
  id            String        @id @default(uuid()) @db.Uuid
  prospectId    String        @map("prospect_id") @db.Uuid
  opportunityId String?       @map("opportunity_id") @db.Uuid
  actorId       String?       @map("actor_id") @db.Uuid
  method        ContactMethod
  summary       String        @db.VarChar(1200)
  occurredAt    DateTime      @map("occurred_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  prospect      Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         User?         @relation("InteractionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([prospectId, occurredAt])
  @@map("crm_interactions")
}

enum ConversationChannel {
  WEB
  WHATSAPP
  EMAIL
  VOICE
}

enum ConversationStatus {
  ACTIVE
  WAITING_HUMAN
  CLOSED
  BLOCKED
}

enum VoiceSessionStatus {
  STARTING
  ACTIVE
  INTERRUPTED
  COMPLETED
  FAILED
}

enum VoiceOperation {
  STT
  TTS
}

enum VoiceCostStatus {
  REPORTED
  COST_PENDING_PROVIDER_RECONCILIATION
}

enum ConversationParticipantType {
  VISITOR
  PROSPECT
  USER
  ASSISTANT
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  BLOCKED
}

enum AIExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ESCALATED
  CONFIGURATION_REQUIRED
}

enum ToolCallStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
}

enum EscalationReason {
  USER_REQUEST
  SENSITIVE_CONTEXT
  LOW_CONFIDENCE
  UNSUPPORTED_INTENT
  REPEATED_ERROR
  HIGH_VALUE_CASE
  AUTOMATION_LIMIT
  POLICY
}

enum EscalationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CANCELLED
}

model Conversation {
  id                   String                    @id @default(uuid()) @db.Uuid
  publicId             String                    @unique @default(uuid()) @map("public_id") @db.Uuid
  accessTokenHash      String                    @map("access_token_hash") @db.Char(64)
  channel              ConversationChannel       @default(WEB)
  status               ConversationStatus        @default(ACTIVE)
  intention            String?                   @db.VarChar(80)
  prospectId           String?                   @map("prospect_id") @db.Uuid
  consentAcceptedAt    DateTime                  @map("consent_accepted_at")
  privacyVersion       String                    @map("privacy_version") @db.VarChar(40)
  lastMessageAt        DateTime?                 @map("last_message_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  prospect             Prospect?                 @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  participants         ConversationParticipant[]
  messages             Message[]
  executions           AIExecution[]
  state                ConversationState?
  escalations          Escalation[]
  voiceSessions        VoiceSession[]
  calendarEvents       CalendarEventLink[]
  meetings             Meeting[]
  communicationThreads CommunicationThread[]
  messagingOperations  HenryMessagingOperation[]

  @@index([status, lastMessageAt])
  @@index([prospectId, createdAt])
  @@index([channel, createdAt])
  @@map("henry_conversations")
}

model VoiceSession {
  id                     String             @id @default(uuid()) @db.Uuid
  conversationId         String             @map("conversation_id") @db.Uuid
  provider               String             @db.VarChar(40)
  externalConversationId String?            @map("external_conversation_id") @db.VarChar(160)
  authenticatedUserId    String?            @map("authenticated_user_id") @db.Uuid
  roleContext            String             @map("role_context") @db.VarChar(30)
  status                 VoiceSessionStatus @default(STARTING)
  metadata               Json?
  startedAt              DateTime           @default(now()) @map("started_at")
  endedAt                DateTime?          @map("ended_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  conversation           Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authenticatedUser      User?              @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  usage                  VoiceUsage[]

  @@unique([provider, externalConversationId])
  @@index([conversationId, startedAt])
  @@index([authenticatedUserId, startedAt])
  @@map("henry_voice_sessions")
}

model VoiceUsage {
  id              String          @id @default(uuid()) @db.Uuid
  voiceSessionId  String          @map("voice_session_id") @db.Uuid
  operation       VoiceOperation
  latencyMs       Int             @map("latency_ms")
  audioDurationMs Int?            @map("audio_duration_ms")
  characterCount  Int?            @map("character_count")
  providerUnits   Decimal?        @map("provider_units") @db.Decimal(18, 6)
  costUsd         Decimal?        @map("cost_usd") @db.Decimal(18, 8)
  costStatus      VoiceCostStatus @default(COST_PENDING_PROVIDER_RECONCILIATION) @map("cost_status")
  failureCategory String?         @map("failure_category") @db.VarChar(80)
  createdAt       DateTime        @default(now()) @map("created_at")
  voiceSession    VoiceSession    @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)

  @@index([voiceSessionId, createdAt])
  @@index([operation, createdAt])
  @@map("henry_voice_usage")
}

model ConversationParticipant {
  id             String                      @id @default(uuid()) @db.Uuid
  conversationId String                      @map("conversation_id") @db.Uuid
  type           ConversationParticipantType
  userId         String?                     @map("user_id") @db.Uuid
  prospectId     String?                     @map("prospect_id") @db.Uuid
  displayName    String?                     @map("display_name") @db.VarChar(120)
  createdAt      DateTime                    @default(now()) @map("created_at")
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  prospect       Prospect?                   @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([conversationId, type])
  @@index([userId])
  @@index([prospectId])
  @@map("henry_conversation_participants")
}

model Message {
  id              String                   @id @default(uuid()) @db.Uuid
  conversationId  String                   @map("conversation_id") @db.Uuid
  participantId   String?                  @map("participant_id") @db.Uuid
  role            MessageRole
  channel         ConversationChannel      @default(WEB)
  status          MessageStatus            @default(RECEIVED)
  content         String                   @db.VarChar(8000)
  origin          String                   @db.VarChar(40)
  metadata        Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  conversation    Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participant     ConversationParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  executionInput  AIExecution[]            @relation("ExecutionInputMessage")
  executionOutput AIExecution[]            @relation("ExecutionOutputMessage")

  @@index([conversationId, createdAt])
  @@map("henry_messages")
}

model ConversationState {
  conversationId String       @id @map("conversation_id") @db.Uuid
  version        Int          @default(1)
  state          Json
  summary        String?      @db.VarChar(2000)
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("henry_conversation_states")
}

enum HenryMessagingIntent {
  EMAIL_DRAFT
  EMAIL_EDIT
  EMAIL_PREVIEW
  EMAIL_SEND
  EMAIL_SCHEDULE
  EMAIL_REPLY
  EMAIL_ATTACH
  EMAIL_CANCEL_SCHEDULED
  EMAIL_BATCH_PREPARE
}

enum HenryMessagingOperationStatus {
  PREVIEW_READY
  AWAITING_CONFIRMATION
  CONFIRMED
  SCHEDULED
  QUEUED
  SENT
  PARTIAL_FAILED
  FAILED
  CANCELLED
  EXPIRED
}

model HenryMessagingOperation {
