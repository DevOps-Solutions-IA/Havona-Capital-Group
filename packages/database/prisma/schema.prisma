generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique @db.VarChar(254)
  name                     String                    @db.VarChar(120)
  passwordHash             String                    @map("password_hash")
  isActive                 Boolean                   @default(true) @map("is_active")
  failedLoginAttempts      Int                       @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime?                 @map("locked_until")
  lastLoginAt              DateTime?                 @map("last_login_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  roles                    UserRole[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]                @relation("AuditActor")
  assignedProspects        Assignment[]              @relation("AssignmentAssignee")
  prospectAssignments      Assignment[]              @relation("AssignmentActor")
  opportunities            Opportunity[]             @relation("OpportunityOwner")
  stageChanges             OpportunityStageHistory[] @relation("StageChangedBy")
  crmTasks                 Task[]                    @relation("TaskAssignee")
  createdTasks             Task[]                    @relation("TaskCreator")
  notes                    Note[]                    @relation("NoteAuthor")
  activities               Activity[]                @relation("ActivityActor")
  interactions             Interaction[]             @relation("InteractionActor")
  convertedClients         ClientProfile[]           @relation("ClientConvertedBy")
  conversationParticipants ConversationParticipant[]
  assignedEscalations      Escalation[]              @relation("EscalationAssignee")
  voiceSessions            VoiceSession[]
  calendarConnections      CalendarConnection[]
  calendarAvailability     CalendarAvailabilityRule?
  calendarEventsCreated    CalendarEventLink[]       @relation("CalendarEventCreator")
  calendarEventsAssigned   CalendarEventLink[]       @relation("CalendarEventAssignee")
  calendarTeamMembers      CalendarTeamMembership[]  @relation("CalendarTeamManager")
  calendarTeamManagers     CalendarTeamMembership[]  @relation("CalendarTeamMember")
  calendarTeamAssignmentsCreated CalendarTeamMembership[] @relation("CalendarTeamCreatedBy")

  @@map("users")
}

enum ProspectStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum ConsentType {
  DATA_PROCESSING
}

enum LeadEventType {
  CAPTURED
  RECAPTURED
}

model LeadSource {
  id        String      @id @default(uuid()) @db.Uuid
  key       String      @unique @db.VarChar(40)
  name      String      @db.VarChar(80)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  prospects Prospect[]
  events    LeadEvent[]

  @@map("lead_sources")
}

model Prospect {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @db.VarChar(120)
  phone                    String?                   @db.VarChar(30)
  normalizedPhone          String?                   @unique @map("normalized_phone") @db.VarChar(20)
  email                    String?                   @db.VarChar(254)
  normalizedEmail          String?                   @unique @map("normalized_email") @db.VarChar(254)
  city                     String                    @db.VarChar(100)
  sourceId                 String                    @map("source_id") @db.Uuid
  campaign                 String?                   @db.VarChar(100)
  landing                  String                    @db.VarChar(80)
  interest                 String                    @db.VarChar(60)
  message                  String?                   @db.VarChar(1200)
  status                   ProspectStatus            @default(NEW)
  firstCapturedAt          DateTime                  @default(now()) @map("first_captured_at")
  lastCapturedAt           DateTime                  @default(now()) @map("last_captured_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  source                   LeadSource                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  consents                 Consent[]
  events                   LeadEvent[]
  assignments              Assignment[]
  opportunities            Opportunity[]
  tasks                    Task[]
  notes                    Note[]
  activities               Activity[]
  tags                     ProspectTag[]
  interactions             Interaction[]
  client                   ClientProfile?
  companyContacts          CompanyContact[]
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  calendarEvents           CalendarEventLink[]

  @@index([status, createdAt])
  @@index([sourceId, createdAt])
  @@index([landing, createdAt])
  @@map("prospects")
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  PROSPECT_CAPTURED
  ASSIGNED
  REASSIGNED
  INTERACTION_RECORDED
  NOTE_CREATED
  NOTE_UPDATED
  TASK_CREATED
  TASK_STATUS_CHANGED
  STAGE_CHANGED
  OPPORTUNITY_CREATED
  OPPORTUNITY_CLOSED
  PROSPECT_UPDATED
  TAG_ATTACHED
  TAG_DETACHED
  CLIENT_CONVERTED
  COMPANY_CREATED
  HENRY_CONVERSATION_STARTED
  HENRY_INTERACTION_RECORDED
  HENRY_ESCALATION_REQUESTED
  HENRY_APPOINTMENT_INTENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model ClientProfile {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @unique @map("prospect_id") @db.Uuid
  convertedById String       @map("converted_by_id") @db.Uuid
  status        ClientStatus @default(ACTIVE)
  convertedAt   DateTime     @default(now()) @map("converted_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  convertedBy   User         @relation("ClientConvertedBy", fields: [convertedById], references: [id], onDelete: Restrict)

  @@index([status, convertedAt])
  @@map("crm_clients")
}

model Company {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @db.VarChar(160)
  legalName     String?          @map("legal_name") @db.VarChar(200)
  taxIdentifier String?          @unique @map("tax_identifier") @db.VarChar(40)
  city          String?          @db.VarChar(100)
  email         String?          @db.VarChar(254)
  phone         String?          @db.VarChar(30)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  contacts      CompanyContact[]
  calendarEvents CalendarEventLink[]

  @@index([name])
  @@map("crm_companies")
}

model CompanyContact {
  companyId  String   @map("company_id") @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  position   String?  @db.VarChar(120)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  @@id([companyId, prospectId])
  @@index([prospectId])
  @@map("crm_company_contacts")
}

enum ContactMethod {
  PHONE
  EMAIL
  MEETING
  VIDEO
  OTHER
}

model PipelineStage {
  id              String                    @id @default(uuid()) @db.Uuid
  key             String                    @unique @db.VarChar(40)
  name            String                    @db.VarChar(80)
  position        Int                       @unique
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  opportunities   Opportunity[]
  transitionsFrom OpportunityStageHistory[] @relation("PreviousStage")
  transitionsTo   OpportunityStageHistory[] @relation("NewStage")

  @@map("pipeline_stages")
}

model Opportunity {
  id           String                    @id @default(uuid()) @db.Uuid
  prospectId   String                    @map("prospect_id") @db.Uuid
  stageId      String                    @map("stage_id") @db.Uuid
  ownerId      String?                   @map("owner_id") @db.Uuid
  title        String                    @db.VarChar(160)
  priority     OpportunityPriority       @default(MEDIUM)
  status       OpportunityStatus         @default(OPEN)
  closedAt     DateTime?                 @map("closed_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  prospect     Prospect                  @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  stage        PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner        User?                     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageHistory OpportunityStageHistory[]
  tasks        Task[]
  notes        Note[]
  activities   Activity[]
  interactions Interaction[]
  calendarEvents CalendarEventLink[]

  @@index([stageId, status, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@index([prospectId, createdAt])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id              String         @id @default(uuid()) @db.Uuid
  opportunityId   String         @map("opportunity_id") @db.Uuid
  previousStageId String?        @map("previous_stage_id") @db.Uuid
  newStageId      String         @map("new_stage_id") @db.Uuid
  changedById     String         @map("changed_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  previousStage   PipelineStage? @relation("PreviousStage", fields: [previousStageId], references: [id], onDelete: Restrict)
  newStage        PipelineStage  @relation("NewStage", fields: [newStageId], references: [id], onDelete: Restrict)
  changedBy       User           @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@map("opportunity_stage_history")
}

model Assignment {
  id           String    @id @default(uuid()) @db.Uuid
  prospectId   String    @map("prospect_id") @db.Uuid
  assigneeId   String    @map("assignee_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assignee     User      @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy   User      @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([prospectId, endedAt])
  @@index([assigneeId, endedAt])
  @@map("assignments")
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  assigneeId    String       @map("assignee_id") @db.Uuid
  createdById   String       @map("created_by_id") @db.Uuid
  title         String       @db.VarChar(160)
  description   String?      @db.VarChar(1200)
  dueAt         DateTime     @map("due_at")
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy     User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  escalations   Escalation[]

  @@index([assigneeId, status, dueAt])
  @@index([prospectId, createdAt])
  @@map("crm_tasks")
}

model Note {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  authorId      String       @map("author_id") @db.Uuid
  body          String       @db.VarChar(4000)
  editedAt      DateTime?    @map("edited_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author        User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@map("crm_notes")
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  prospectId    String       @map("prospect_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  actorId       String?      @map("actor_id") @db.Uuid
  type          ActivityType
  summary       String       @db.VarChar(300)
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([opportunityId, createdAt])
  @@map("crm_activities")
}

model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(60)
  color     String        @db.VarChar(7)
  createdAt DateTime      @default(now()) @map("created_at")
  prospects ProspectTag[]

  @@map("crm_tags")
}

model ProspectTag {
  prospectId String   @map("prospect_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
  @@map("prospect_tags")
}

model Interaction {
  id            String        @id @default(uuid()) @db.Uuid
  prospectId    String        @map("prospect_id") @db.Uuid
  opportunityId String?       @map("opportunity_id") @db.Uuid
  actorId       String?       @map("actor_id") @db.Uuid
  method        ContactMethod
  summary       String        @db.VarChar(1200)
  occurredAt    DateTime      @map("occurred_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  prospect      Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         User?         @relation("InteractionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([prospectId, occurredAt])
  @@map("crm_interactions")
}

enum ConversationChannel {
  WEB
  WHATSAPP
  EMAIL
  VOICE
}

enum ConversationStatus {
  ACTIVE
  WAITING_HUMAN
  CLOSED
  BLOCKED
}

enum VoiceSessionStatus {
  STARTING
  ACTIVE
  INTERRUPTED
  COMPLETED
  FAILED
}

enum VoiceOperation {
  STT
  TTS
}

enum VoiceCostStatus {
  REPORTED
  COST_PENDING_PROVIDER_RECONCILIATION
}

enum ConversationParticipantType {
  VISITOR
  PROSPECT
  USER
  ASSISTANT
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  BLOCKED
}

enum AIExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ESCALATED
  CONFIGURATION_REQUIRED
}

enum ToolCallStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
}

enum EscalationReason {
  USER_REQUEST
  SENSITIVE_CONTEXT
  LOW_CONFIDENCE
  UNSUPPORTED_INTENT
  REPEATED_ERROR
  HIGH_VALUE_CASE
  AUTOMATION_LIMIT
  POLICY
}

enum EscalationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CANCELLED
}

model Conversation {
  id                String                    @id @default(uuid()) @db.Uuid
  publicId          String                    @unique @default(uuid()) @map("public_id") @db.Uuid
  accessTokenHash   String                    @map("access_token_hash") @db.Char(64)
  channel           ConversationChannel       @default(WEB)
  status            ConversationStatus        @default(ACTIVE)
  intention         String?                   @db.VarChar(80)
  prospectId        String?                   @map("prospect_id") @db.Uuid
  consentAcceptedAt DateTime                  @map("consent_accepted_at")
  privacyVersion    String                    @map("privacy_version") @db.VarChar(40)
  lastMessageAt     DateTime?                 @map("last_message_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  prospect          Prospect?                 @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  participants      ConversationParticipant[]
  messages          Message[]
  executions        AIExecution[]
  state             ConversationState?
  escalations       Escalation[]
  voiceSessions     VoiceSession[]
  calendarEvents     CalendarEventLink[]

  @@index([status, lastMessageAt])
  @@index([prospectId, createdAt])
  @@index([channel, createdAt])
  @@map("henry_conversations")
}

model VoiceSession {
  id                     String             @id @default(uuid()) @db.Uuid
  conversationId         String             @map("conversation_id") @db.Uuid
  provider               String             @db.VarChar(40)
  externalConversationId String?            @map("external_conversation_id") @db.VarChar(160)
  authenticatedUserId    String?            @map("authenticated_user_id") @db.Uuid
  roleContext            String             @map("role_context") @db.VarChar(30)
  status                 VoiceSessionStatus @default(STARTING)
  metadata               Json?
  startedAt              DateTime           @default(now()) @map("started_at")
  endedAt                DateTime?          @map("ended_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  conversation           Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authenticatedUser      User?              @relation(fields: [authenticatedUserId], references: [id], onDelete: SetNull)
  usage                  VoiceUsage[]

  @@unique([provider, externalConversationId])
  @@index([conversationId, startedAt])
  @@index([authenticatedUserId, startedAt])
  @@map("henry_voice_sessions")
}

model VoiceUsage {
  id              String          @id @default(uuid()) @db.Uuid
  voiceSessionId  String          @map("voice_session_id") @db.Uuid
  operation       VoiceOperation
  latencyMs       Int             @map("latency_ms")
  audioDurationMs Int?            @map("audio_duration_ms")
  characterCount  Int?            @map("character_count")
  providerUnits   Decimal?        @map("provider_units") @db.Decimal(18, 6)
  costUsd         Decimal?        @map("cost_usd") @db.Decimal(18, 8)
  costStatus      VoiceCostStatus @default(COST_PENDING_PROVIDER_RECONCILIATION) @map("cost_status")
  failureCategory String?         @map("failure_category") @db.VarChar(80)
  createdAt       DateTime        @default(now()) @map("created_at")
  voiceSession    VoiceSession    @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)

  @@index([voiceSessionId, createdAt])
  @@index([operation, createdAt])
  @@map("henry_voice_usage")
}

model ConversationParticipant {
  id             String                      @id @default(uuid()) @db.Uuid
  conversationId String                      @map("conversation_id") @db.Uuid
  type           ConversationParticipantType
  userId         String?                     @map("user_id") @db.Uuid
  prospectId     String?                     @map("prospect_id") @db.Uuid
  displayName    String?                     @map("display_name") @db.VarChar(120)
  createdAt      DateTime                    @default(now()) @map("created_at")
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  prospect       Prospect?                   @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([conversationId, type])
  @@index([userId])
  @@index([prospectId])
  @@map("henry_conversation_participants")
}

model Message {
  id              String                   @id @default(uuid()) @db.Uuid
  conversationId  String                   @map("conversation_id") @db.Uuid
  participantId   String?                  @map("participant_id") @db.Uuid
  role            MessageRole
  channel         ConversationChannel      @default(WEB)
  status          MessageStatus            @default(RECEIVED)
  content         String                   @db.VarChar(8000)
  origin          String                   @db.VarChar(40)
  metadata        Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  conversation    Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participant     ConversationParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  executionInput  AIExecution[]            @relation("ExecutionInputMessage")
  executionOutput AIExecution[]            @relation("ExecutionOutputMessage")

  @@index([conversationId, createdAt])
  @@map("henry_messages")
}

model ConversationState {
  conversationId String       @id @map("conversation_id") @db.Uuid
  version        Int          @default(1)
  state          Json
  summary        String?      @db.VarChar(2000)
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("henry_conversation_states")
}

model AIExecution {
  id              String            @id @default(uuid()) @db.Uuid
  conversationId  String            @map("conversation_id") @db.Uuid
  inputMessageId  String            @map("input_message_id") @db.Uuid
  outputMessageId String?           @map("output_message_id") @db.Uuid
  provider        String            @db.VarChar(40)
  model           String            @db.VarChar(160)
  status          AIExecutionStatus @default(RUNNING)
  latencyMs       Int?              @map("latency_ms")
  iterations      Int               @default(0)
  errorCode       String?           @map("error_code") @db.VarChar(80)
  errorMessage    String?           @map("error_message") @db.VarChar(500)
  policyContext   Json?             @map("policy_context")
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inputMessage    Message           @relation("ExecutionInputMessage", fields: [inputMessageId], references: [id], onDelete: Restrict)
  outputMessage   Message?          @relation("ExecutionOutputMessage", fields: [outputMessageId], references: [id], onDelete: SetNull)
  toolCalls       ToolCall[]
  usage           AIUsage?

  @@index([conversationId, startedAt])
  @@index([status, startedAt])
  @@map("henry_ai_executions")
}

model ToolCall {
  id          String         @id @default(uuid()) @db.Uuid
  executionId String         @map("execution_id") @db.Uuid
  providerId  String?        @map("provider_id") @db.VarChar(120)
  name        String         @db.VarChar(80)
  input       Json
  status      ToolCallStatus @default(REQUESTED)
  errorCode   String?        @map("error_code") @db.VarChar(80)
  policyId    String?        @map("policy_id") @db.VarChar(80)
  ruleId      String?        @map("rule_id") @db.VarChar(120)
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  execution   AIExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  result      ToolResult?

  @@index([executionId, createdAt])
  @@map("henry_tool_calls")
}

model ToolResult {
  id         String   @id @default(uuid()) @db.Uuid
  toolCallId String   @unique @map("tool_call_id") @db.Uuid
  success    Boolean
  output     Json
  createdAt  DateTime @default(now()) @map("created_at")
  toolCall   ToolCall @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@map("henry_tool_results")
}

model AIUsage {
  id               String      @id @default(uuid()) @db.Uuid
  executionId      String      @unique @map("execution_id") @db.Uuid
  inputTokens      Int?        @map("input_tokens")
  outputTokens     Int?        @map("output_tokens")
  totalTokens      Int?        @map("total_tokens")
  estimatedCostUsd Decimal?    @map("estimated_cost_usd") @db.Decimal(18, 8)
  costSource       String?     @map("cost_source") @db.VarChar(40)
  createdAt        DateTime    @default(now()) @map("created_at")
  execution        AIExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("henry_ai_usage")
}

model Escalation {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  reason         EscalationReason
  status         EscalationStatus @default(OPEN)
  summary        String           @db.VarChar(1200)
  assignedToId   String?          @map("assigned_to_id") @db.Uuid
  taskId         String?          @map("task_id") @db.Uuid
  policyId       String?          @map("policy_id") @db.VarChar(80)
  ruleId         String?          @map("rule_id") @db.VarChar(120)
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedTo     User?            @relation("EscalationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
  @@map("henry_escalations")
}

model Consent {
  id             String      @id @default(uuid()) @db.Uuid
  prospectId     String      @map("prospect_id") @db.Uuid
  type           ConsentType @default(DATA_PROCESSING)
  accepted       Boolean
  privacyVersion String      @map("privacy_version") @db.VarChar(40)
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.VarChar(512)
  acceptedAt     DateTime    @default(now()) @map("accepted_at")
  prospect       Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, acceptedAt])
  @@map("consents")
}

model LeadEvent {
  id           String        @id @default(uuid()) @db.Uuid
  prospectId   String        @map("prospect_id") @db.Uuid
  submissionId String        @unique @map("submission_id") @db.Uuid
  type         LeadEventType
  sourceId     String        @map("source_id") @db.Uuid
  landing      String        @db.VarChar(80)
  campaign     String?       @db.VarChar(100)
  interest     String        @db.VarChar(60)
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  prospect     Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  source       LeadSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@index([type, createdAt])
  @@index([sourceId, createdAt])
  @@map("lead_events")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(40)
  description String?          @db.VarChar(240)
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  description String           @db.VarChar(240)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfHash  String    @map("csrf_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  resource    String   @db.VarChar(80)
  resourceId  String?  @map("resource_id") @db.VarChar(80)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(240)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum CalendarProviderType {
  GOOGLE
}

enum CalendarConnectionStatus {
  ACTIVE
  NEEDS_REAUTHORIZATION
  DISCONNECTED
  ERROR
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum CalendarMutationStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

model CalendarConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @map("user_id") @db.Uuid
  provider              CalendarProviderType     @default(GOOGLE)
  providerAccountId     String                   @map("provider_account_id") @db.VarChar(254)
  accountEmail          String                   @map("account_email") @db.VarChar(254)
  selectedCalendarId    String                   @default("primary") @map("selected_calendar_id") @db.VarChar(512)
  selectedCalendarName  String?                  @map("selected_calendar_name") @db.VarChar(200)
  timezone              String                   @default("America/Bogota") @db.VarChar(100)
  encryptedAccessToken  String                   @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?                  @map("encrypted_refresh_token") @db.Text
  accessTokenExpiresAt  DateTime?                @map("access_token_expires_at")
  grantedScopes         String[]                 @map("granted_scopes")
  status                CalendarConnectionStatus @default(ACTIVE)
  lastSyncedAt          DateTime?                @map("last_synced_at")
  lastErrorCode         String?                  @map("last_error_code") @db.VarChar(80)
  disconnectedAt        DateTime?                @map("disconnected_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events                CalendarEventLink[]
  syncState             CalendarSyncState?
  webhookChannels       CalendarWebhookChannel[]
  mutations             CalendarMutation[]

  @@unique([provider, providerAccountId, userId])
  @@index([userId, status])
  @@map("calendar_connections")
}

model CalendarAvailabilityRule {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  timezone                 String   @default("America/Bogota") @db.VarChar(100)
  workingDays              Int[]    @default([1, 2, 3, 4, 5]) @map("working_days")
  workStart                String   @default("08:00") @map("work_start") @db.VarChar(5)
  workEnd                  String   @default("18:00") @map("work_end") @db.VarChar(5)
  minimumNoticeMinutes     Int      @default(120) @map("minimum_notice_minutes")
  defaultMeetingDuration   Int      @default(45) @map("default_meeting_duration")
  bufferBeforeMinutes      Int      @default(15) @map("buffer_before_minutes")
  bufferAfterMinutes       Int      @default(15) @map("buffer_after_minutes")
  maximumFutureBookingDays Int      @default(90) @map("maximum_future_booking_days")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_availability_rules")
}

model CalendarTeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  managerId String   @map("manager_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  manager   User     @relation("CalendarTeamManager", fields: [managerId], references: [id], onDelete: Cascade)
  member    User     @relation("CalendarTeamMember", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CalendarTeamCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([managerId, memberId])
  @@index([memberId])
  @@map("calendar_team_memberships")
}

model CalendarEventLink {
  id                  String              @id @default(uuid()) @db.Uuid
  connectionId        String              @map("connection_id") @db.Uuid
  providerEventId     String              @map("provider_event_id") @db.VarChar(512)
  providerEtag        String?             @map("provider_etag") @db.VarChar(256)
  calendarId          String              @map("calendar_id") @db.VarChar(512)
  title               String              @db.VarChar(240)
  startAt             DateTime            @map("start_at")
  endAt               DateTime            @map("end_at")
  timezone            String              @db.VarChar(100)
  status              CalendarEventStatus @default(CONFIRMED)
  htmlLink            String?             @map("html_link") @db.VarChar(1200)
  conferenceLink      String?             @map("conference_link") @db.VarChar(1200)
  attendees           Json?
  prospectId          String?             @map("prospect_id") @db.Uuid
  companyId           String?             @map("company_id") @db.Uuid
  opportunityId       String?             @map("opportunity_id") @db.Uuid
  conversationId      String?             @map("conversation_id") @db.Uuid
  createdById         String              @map("created_by_id") @db.Uuid
  assignedConsultantId String?            @map("assigned_consultant_id") @db.Uuid
  cancellationReason  String?             @map("cancellation_reason") @db.VarChar(500)
  cancelledAt         DateTime?           @map("cancelled_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  connection          CalendarConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  prospect            Prospect?           @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  company             Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity         Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  conversation        Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy           User                @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedConsultant  User?               @relation("CalendarEventAssignee", fields: [assignedConsultantId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerEventId])
  @@index([startAt, status])
  @@index([prospectId, startAt])
  @@index([opportunityId, startAt])
  @@index([assignedConsultantId, startAt])
  @@map("calendar_event_links")
}

model CalendarSyncState {
  id             String             @id @default(uuid()) @db.Uuid
  connectionId   String             @unique @map("connection_id") @db.Uuid
  syncToken      String?            @map("sync_token") @db.Text
  lastFullSyncAt DateTime?          @map("last_full_sync_at")
  lastSyncAt     DateTime?          @map("last_sync_at")
  lastStatus     String?            @map("last_status") @db.VarChar(40)
  lastErrorCode  String?            @map("last_error_code") @db.VarChar(80)
  updatedAt      DateTime           @updatedAt @map("updated_at")
  connection     CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("calendar_sync_states")
}

model CalendarWebhookChannel {
  id                 String             @id @default(uuid()) @db.Uuid
  connectionId       String             @map("connection_id") @db.Uuid
  channelId          String             @unique @map("channel_id") @db.VarChar(160)
  resourceId         String?            @map("resource_id") @db.VarChar(256)
  encryptedToken     String             @map("encrypted_token") @db.Text
  expiration         DateTime
  stoppedAt          DateTime?          @map("stopped_at")
  lastNotificationAt DateTime?          @map("last_notification_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  connection         CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, expiration])
  @@map("calendar_webhook_channels")
}

model CalendarMutation {
  id             String                 @id @default(uuid()) @db.Uuid
  connectionId   String                 @map("connection_id") @db.Uuid
  idempotencyKey String                 @map("idempotency_key") @db.VarChar(120)
  operation      String                 @db.VarChar(40)
  status         CalendarMutationStatus @default(PROCESSING)
  result         Json?
  errorCode      String?                @map("error_code") @db.VarChar(80)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  connection     CalendarConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, idempotencyKey])
  @@index([createdAt])
  @@map("calendar_mutations")
}

model CalendarOAuthState {
  id                    String   @id @default(uuid()) @db.Uuid
  stateHash             String   @unique @map("state_hash") @db.Char(64)
  userId                String   @map("user_id") @db.Uuid
  encryptedCodeVerifier String   @map("encrypted_code_verifier") @db.Text
  expiresAt             DateTime @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("calendar_oauth_states")
}
